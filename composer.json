{
  "name": "pbintegracoes/pbconnect-prestashop",
  "description": "PB Connect payment module for PrestaShop (API v1 / Vindi)",
  "version": "5.0.1",
  "type": "prestashop-module",
  "license": "MIT",
  "authors": [
    {
      "name": "PB Integrações",
      "homepage": "https://pbintegracoes.com"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "config": {
    "prepend-autoloader": false
  },
  "autoload": {
    "psr-4": {
